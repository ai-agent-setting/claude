{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "high",
  "autoCompactWindow": 60000,
  "autoMemoryEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"컨텍스트 70% 도달 — /checkpoint 실행 권장\" with title \"Claude Code\"'; exit 2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"답변이 완료되었습니다\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude가 입력 또는 허가를 기다리고 있습니다\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  }
}
